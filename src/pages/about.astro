---
const siteName = "DavidVR";
const description = "About DavidVR and my website.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    <title>About Me | {siteName}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">DavidVR</a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a class="active" href="/about">About</a>
        <a href="https://info.davidvrsite.com">Info</a>
        <a class="contact-link" href="mailto:davidvr@davidvrsite.com">Email</a>
      </nav>
    </header>

    <main>
      <section class="about">
        <p class="eyebrow">About me</p>
        <h1>Hi, I'm DavidVR 👋</h1>
        <p class="lead">Welcome to my website!</p>
        <p>
          I'm DavidVR, and this is my personal place on the web. I enjoy gaming,
          creating things online, and working on websites and projects.
        </p>
        <p>
          This website is being rebuilt from my old Google Sites website using Astro.
        </p>
        <a class="email-button" href="mailto:davidvr@davidvrsite.com">Email DavidVR</a>
      </section>
    </main>

    <footer>
      <a class="copyright" href="/copyright">© 2026 DavidVR</a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; background: #f6f8fc; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 7%; background: white; border-bottom: 1px solid #e6e9f0; position: sticky; top: 0; z-index: 10; }
  .logo { font-weight: 800; font-size: 1.25rem; color: #172033; text-decoration: none; }
  nav { display: flex; gap: 22px; }
  nav a { color: #315ee7; text-decoration: none; font-weight: 600; }
  nav .contact-link { color: white; background: #315ee7; padding: 7px 12px; border-radius: 8px; }
  nav a.active { text-decoration: underline; text-underline-offset: 5px; }
  .about { max-width: 800px; margin: 0 auto; padding: 90px 24px 100px; }
  .eyebrow { color: #315ee7; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  h1 { font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 1.05; margin: 12px 0 20px; }
  .lead { font-size: 1.35rem; font-weight: 600; }
  .about p:not(.eyebrow):not(.lead) { color: #5e687b; font-size: 1.08rem; line-height: 1.8; }
  .email-button { display: inline-block; margin-top: 18px; padding: 12px 20px; border-radius: 10px; background: #315ee7; color: white; font-weight: 700; text-decoration: none; }
  .email-button:hover, .email-button:focus-visible { transform: translateY(-1px); box-shadow: 0 5px 14px rgba(49, 94, 231, .2); }
  .email-button:focus-visible, nav a:focus-visible { outline: 3px solid #8ca8ff; outline-offset: 3px; }
  footer { text-align: center; padding: 30px 20px; color: #697386; border-top: 1px solid #e6e9f0; background: white; }
  @media (max-width: 650px) { .site-header { padding: 16px 20px; } nav { gap: 12px; } }
  .copyright { color: inherit; text-decoration: none; }
  .copyright:hover { text-decoration: underline; }
</style>
