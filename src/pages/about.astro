---
const siteName = "DavidVR";
const description = "About DavidVR and my website.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>About Me | {siteName}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">DavidVR</a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a class="active" href="/about">About</a>
      </nav>
    </header>

    <main>
      <section class="about">
        <p class="eyebrow">About me</p>
        <h1>Hi, I'm DavidVR 👋</h1>
        <p class="lead">Welcome to my website!</p>
        <p>
          I'm DavidVR, and this website is my personal place on the web. I enjoy gaming,
          creating things online, and working on websites and projects.
        </p>
        <p>
          This site is being rebuilt from my old Google Sites website using Astro, while keeping
          the simple personal feel of the original.
        </p>

        <div class="links">
          <a href="https://www.davidvrsite.com">Visit davidvrsite.com →</a>
          <a href="https://github.com/David686-goyu/davidvrsite">View the GitHub project →</a>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} DavidVR</p>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #172033;
    background: #f6f8fc;
  }
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 7%;
    background: white;
    border-bottom: 1px solid #e6e9f0;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .logo { font-weight: 800; font-size: 1.25rem; color: #172033; text-decoration: none; }
  nav { display: flex; gap: 22px; }
  nav a { color: #315ee7; text-decoration: none; font-weight: 600; }
  nav a.active { text-decoration: underline; text-underline-offset: 5px; }
  .about {
    max-width: 800px;
    margin: 0 auto;
    padding: 90px 24px 100px;
  }
  .eyebrow {
    color: #315ee7;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  h1 { font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 1.05; margin: 12px 0 20px; }
  .lead { font-size: 1.35rem; font-weight: 600; }
  .about p:not(.eyebrow):not(.lead) { color: #5e687b; font-size: 1.08rem; line-height: 1.8; }
  .links { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .links a { color: #315ee7; text-decoration: none; font-weight: 700; }
  footer { text-align: center; padding: 30px 20px; color: #697386; border-top: 1px solid #e6e9f0; background: white; }
</style>
