---
const siteName = "DavidVR";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Copyright notice for DavidVR." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Copyright | {siteName}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">DavidVR</a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="https://info.davidvrsite.com">Info</a>
        <a class="contact-link" href="mailto:davidvr@davidvrsite.com">Email</a>
      </nav>
    </header>

    <main>
      <article class="page">
        <p class="eyebrow">Legal</p>
        <h1>Copyright, Designs and Patents Act 1988</h1>

        <p>
          Unless otherwise stated, the original content, design, graphics, text,
          and other creative works on this website are protected by copyright and
          related rights. Copyright protection in the United Kingdom is governed,
          among other legislation, by the Copyright, Designs and Patents Act 1988.
        </p>

        <h2>Copyright</h2>
        <p>
          © {new Date().getFullYear()} DavidVR. All rights reserved.
        </p>
        <p>
          You may view this website for personal, non-commercial purposes. Do not
          copy, reproduce, redistribute, modify, or publish substantial portions of
          the site's original content without permission, unless an applicable legal
          exception permits it.
        </p>

        <h2>Third-party content</h2>
        <p>
          Some content may belong to third parties and remains subject to their own
          copyright, trademark, or other rights. This notice does not claim ownership
          of third-party material.
        </p>

        <h2>Permission</h2>
        <p>
          For permission to use original DavidVR content beyond what is allowed by
          law, please contact the site owner before using it.
        </p>

        <p class="note">
          This page is a general copyright notice and is not legal advice.
        </p>
      </article>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} DavidVR</p>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; background: #f6f8fc; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 7%; background: white; border-bottom: 1px solid #e6e9f0; position: sticky; top: 0; z-index: 10; }
  .logo { font-weight: 800; font-size: 1.25rem; color: #172033; text-decoration: none; }
  nav { display: flex; gap: 22px; }
  nav a { color: #315ee7; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; min-height: 36px; line-height: 1; }
  nav .contact-link { color: white; background: #315ee7; padding: 0 12px; border-radius: 8px; }
  nav a:focus-visible { outline: 3px solid #8ca8ff; outline-offset: 3px; }
  .page { max-width: 850px; margin: 0 auto; padding: 70px 24px 90px; background: white; }
  main { min-height: calc(100vh - 150px); }
  .eyebrow { color: #315ee7; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  h1 { font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1.05; margin: 12px 0 30px; }
  h2 { margin-top: 38px; }
  p { color: #5e687b; line-height: 1.75; }
  .note { margin-top: 45px; padding: 16px; border: 1px solid #e6e9f0; border-radius: 10px; font-size: .95rem; }
  footer { text-align: center; padding: 30px 20px; color: #697386; border-top: 1px solid #e6e9f0; background: white; }
  @media (max-width: 650px) { .site-header { padding: 16px 20px; } nav { gap: 12px; } }
</style>
