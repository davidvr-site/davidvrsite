---
const mainSite = "https://davidvrsite.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The DavidVR shop address now redirects to davidvrsite.com." />
    <meta http-equiv="refresh" content="5;url=https://davidvrsite.com" />
    <title>Shop redirect | DavidVR</title>
    <style>
      :root { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; background: #f6f8fc; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; box-sizing: border-box; }
      main { width: min(100%, 620px); padding: 40px; box-sizing: border-box; background: white; border: 1px solid #e6e9f0; border-radius: 18px; box-shadow: 0 12px 40px rgba(20, 30, 55, .08); }
      h1 { margin: 12px 0; font-size: clamp(2rem, 7vw, 3rem); }
      p { color: #5e687b; line-height: 1.7; }
      a { display: inline-block; margin-top: 12px; padding: 12px 18px; border-radius: 10px; color: white; background: #315ee7; font-weight: 700; text-decoration: none; }
      a:focus-visible { outline: 3px solid #8ca8ff; outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <p>DavidVR shop update</p>
      <h1>You’re being redirected</h1>
      <p>
        <strong>shop.davidvrsite.com</strong> now redirects to
        <strong>davidvrsite.com</strong>. You’ll be taken there shortly.
      </p>
      <a href={mainSite}>Continue to davidvrsite.com</a>
    </main>
  </body>
</html>
