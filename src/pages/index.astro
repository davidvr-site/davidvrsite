---
// SERVER-SIDE JAVASCRIPT (Runs at build time or on Cloudflare Edge)
const siteName = "My Cloudflare Pages App";
const currentTime = new Date().toLocaleTimeString();

// Fetching data at build/request time on the server
let serverData = null;
try {
  const res = await fetch("https://api.github.com/zen");
  serverData = await res.text();
} catch (e) {
  serverData = "Could not fetch quote";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{siteName}</title>
  </head>
  <body>
    <h1>Welcome to {siteName}!</h1>
    <p>Page rendered at: {currentTime}</p>
    <p>Server Quote: <em>"{serverData}"</em></p>

    <!-- Client Interactive Element -->
    <button id="counterBtn">Clicks: 0</button>

    <!-- CLIENT-SIDE JAVASCRIPT (Runs in the browser) -->
    <script>
      let count = 0;
      const btn = document.getElementById("counterBtn");

      btn?.addEventListener("click", () => {
        count++;
        btn.textContent = `Clicks: ${count}`;
      });
    </script>
  </body>
</html>
